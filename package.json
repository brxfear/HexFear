{
  "name": "hexfear",
  "version": "0.4.0",
  "description": "HexFear — AI destekli, yerel çalışan tersine mühendislik analiz aracı (CTF / crackme / yetkili açık denetimi için).",
  "main": "main.js",
  "bin": {
    "hexfear-mcp": "src/mcp/server.js"
  },
  "scripts": {
    "start": "electron .",
    "mcp": "node src/mcp/server.js",
    "test": "node --test",
    "dev": "electron . --dev",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir"
  },
  "keywords": [
    "reverse-engineering",
    "ctf",
    "crackme",
    "security",
    "ai",
    "electron"
  ],
  "author": "Brxfear",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "re.brxfear.hexfear",
    "productName": "HexFear",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
